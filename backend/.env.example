# 复制本文件为 .env 并填入实际值
APP_NAME=Vibebara
APP_VERSION=0.1.0
DEBUG=true

# 运行模式：local（默认，浏览器+后端+用户文件同机）| cloud（云端中央后端）
DEPLOYMENT_MODE=local

HOST=0.0.0.0
PORT=8000

# MySQL async 连接串
DATABASE_URL=mysql+aiomysql://root:YOUR_PASSWORD@localhost:3306/cowork?charset=utf8mb4

# --- 连接池（托管 MySQL 调优；默认值与现状一致，可不填） ---
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=false
# DB_ECHO=            # 留空跟随 DEBUG；true/false 可显式覆盖
# 启动时自动建表（开发兜底）。云端用 Alembic 管理 schema 时设为 false。
# DB_AUTO_CREATE=true

# --- 托管 MySQL TLS（默认关闭，不影响本地明文连接） ---
# DB_SSL_ENABLED=false
# DB_SSL_CA=/path/to/ca.pem    # 设置后自动启用 TLS
# DB_SSL_VERIFY=true

# 外部 skill 自动扫描目录（留空则禁用；cloud 模式忽略）
SKILL_SCAN_DIR=

# 数据根目录（去 user-home 依赖）。留空 → backend/data
COWORK_DATA_DIR=
# 平台原生 skill 集中存储目录。留空 → {COWORK_DATA_DIR}/skills
SKILL_STORE_DIR=

ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# 桌面端来源（Electron file:// / app:// / 自定义 scheme）正则放行；留空不启用
# 示例：ALLOW_ORIGIN_REGEX=^(app|vibebara|file)://.*$
ALLOW_ORIGIN_REGEX=
ENABLED_ADAPTERS=["cursor","copilot","windsurf","claude"]

# --- 安全 / 鉴权（方案 B M2） ---
# 独立的 token 签名密钥（停止复用 LLM_API_KEY）。
#   留空 → 使用稳定的开发默认密钥（重启不失效，仅限本地开发）；
#   cloud/生产务必注入高熵随机值（例如 `python -c "import secrets;print(secrets.token_urlsafe(48))"`）。
#   注意：更换该值会使所有旧 token 失效，用户需重新登录。
JWT_SECRET=
# session WS（/ws/{session_id}）是否强制鉴权。默认 false 兼容现有 sessions 功能；
# 置 true 需前端在 WS URL 上补传 token（见 M2 文档）。项目级 WS 始终强制，不受此开关影响。
WS_SESSION_AUTH_REQUIRED=false

# --- 注册邀请码（测试版收口注册入口） ---
# true = 注册必须提供有效邀请码（默认）；本地开发可设 false 放开注册。
# 签发：docker compose exec backend python scripts/generate_invites.py -n 10
INVITE_CODE_REQUIRED=true
# 邀请码管理端点（/api/v1/invites）的管理员用户名白名单（JSON 数组）
ADMIN_USERNAMES=["DAIL"]

# LLM API (GPTs API Gateway)
# LLM_BASE_URL=https://api.gptsapi.net
# LLM_API_KEY=
# LLM_MODEL=gpt-4o
